{
  "name": "atdrive-angular-test",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/main.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "ngc -p tsconfig.app.json && webpack --config webpack.config.cjs",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/main.js",
    "db:init": "npm run build:server && node dist/server/init.js",
    "seed": "npm run build:server && node dist/server/seed.js",
    "test": "vitest run --configLoader native",
    "test:integration": "npm run build:server && node scripts/test-database.cjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && ngc -p tsconfig.app.json --noEmit",
    "format": "prettier --write server client/src tests scripts sql *.json *.mts *.ts *.cjs *.yml",
    "format:check": "prettier --check server client/src tests scripts *.json *.mts *.ts *.cjs *.yml"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "mysql2": "^3.15.0",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@angular/compiler-cli": "22.2.3",
    "@babel/core": "^8.0.9",
    "@playwright/test": "^1.56.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.12",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
